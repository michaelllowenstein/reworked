#!/usr/bin/env python3
"""envguard - secret scanning, .env schema validation and dependency audit in one report.

Usage:
  envguard [all] [DIR]                    run scan + schema + deps (default)
  envguard scan [DIR] [--staged] [--untracked]
  envguard schema [DIR] [--env FILE] [--schema FILE]
  envguard init-schema [DIR]              draft .env.schema from .env / .env.example
  envguard deps [DIR]                     pip-audit / npm audit when installed
  envguard install-hook [DIR]             add a git pre-commit hook running `envguard scan --staged`

Suppress a finding with an inline `envguard:allow` comment, or list globs in .envguardignore.
Exit code 1 when there are high-severity findings. Hub capability: audit.security
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import math
import os
import re
import shutil
import stat
import subprocess
import sys
from collections import Counter
from pathlib import Path

VERSION = "0.1.0"
CAPABILITIES = {"audit.security": ["all", "--json"]}

RULES = [
    ("aws-access-key", "high", re.compile(r"\b(AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("private-key", "high", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----")),
    ("github-token", "high", re.compile(r"\b(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})\b")),
    ("slack-token", "high", re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}\b")),
    ("slack-webhook", "high", re.compile(r"https://hooks\.slack\.com/services/T[A-Za-z0-9]+/B[A-Za-z0-9]+/[A-Za-z0-9]+")),
    ("stripe-live-key", "high", re.compile(r"\b[rs]k_live_[0-9a-zA-Z]{20,}\b")),
    ("google-api-key", "high", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("anthropic-key", "high", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}")),
    ("openai-key", "high", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}")),
    ("jwt", "medium", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    ("url-credentials", "high", re.compile(r"\b[a-z][a-z0-9+.-]*://[^/\s:@'\"]+:([^/\s@'\"]{6,})@[^\s'\"]+")),
]
ASSIGN = re.compile(r"""(?i)\b([A-Z0-9_.-]*(?:password|passwd|secret|api[_-]?key|access[_-]?key|token|auth[_-]?key|private[_-]?key)[A-Z0-9_]*)\b["']?\s*[:=]\s*["']?([^\s"',;#]{8,})""")
PLACEHOLDER = re.compile(r"(?i)(changeme|change_me|example|placeholder|your[_-]|xxx+|\*\*\*|<.*>|\$\{|\$\(|process\.env|os\.environ|getenv|env\(|dummy|sample|test|fake|redacted|none|null|true|false|^\.\.\.)")
SKIP_EXT = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".zip", ".gz", ".tgz", ".woff", ".woff2", ".ttf",
            ".mp4", ".mov", ".mp3", ".lock", ".min.js", ".map", ".svg"}
SKIP_NAMES = {"package-lock.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock", "Cargo.lock", "go.sum"}


def log(msg):
    print(f"envguard: {msg}", file=sys.stderr)


def git(d, *args, text=True):
    try:
        p = subprocess.run(["git", "-C", str(d), *args], capture_output=True, text=text, timeout=60)
        return p.stdout if p.returncode == 0 else None
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None


def entropy(s):
    if not s:
        return 0.0
    c = Counter(s)
    return -sum(n / len(s) * math.log2(n / len(s)) for n in c.values())


def mask(s):
    return s[:4] + "*" * min(12, max(4, len(s) - 4)) if len(s) > 4 else "****"


def ignore_globs(d: Path):
    p = d / ".envguardignore"
    if not p.is_file():
        return []
    return [l.strip() for l in p.read_text().splitlines() if l.strip() and not l.startswith("#")]


def files_to_scan(d: Path, staged: bool, untracked: bool):
    is_git = git(d, "rev-parse", "--show-toplevel") is not None
    if staged:
        out = git(d, "diff", "--cached", "--name-only", "--diff-filter=ACM", "-z") or ""
        return [(f, "index") for f in out.split("\0") if f], is_git
    if is_git:
        out = git(d, "ls-files", "-z") or ""
        files = [(f, "worktree") for f in out.split("\0") if f]
        if untracked:
            extra = git(d, "ls-files", "--others", "--exclude-standard", "-z") or ""
            files += [(f, "worktree") for f in extra.split("\0") if f]
        return files, is_git
    files = []
    for root, dirs, names in os.walk(d):
        dirs[:] = [x for x in dirs if x not in {".git", "node_modules", ".venv", "venv", "__pycache__", "dist", "build"}]
        for n in names:
            files.append((os.path.relpath(Path(root) / n, d), "worktree"))
    return files, is_git


def read_content(d: Path, rel: str, source: str):
    if source == "index":
        try:
            p = subprocess.run(["git", "-C", str(d), "show", f":{rel}"], capture_output=True, timeout=30)
            data = p.stdout if p.returncode == 0 else b""
        except subprocess.TimeoutExpired:
            data = b""
    else:
        p = d / rel
        try:
            if not p.is_file() or p.stat().st_size > 1_000_000:
                return None
            data = p.read_bytes()
        except OSError:
            return None
    if b"\0" in data[:4096]:
        return None
    return data.decode("utf-8", "replace")


def scan(d: Path, staged=False, untracked=False):
    files, is_git = files_to_scan(d, staged, untracked)
    globs = ignore_globs(d)
    findings = []
    for rel, source in files:
        name = os.path.basename(rel)
        if name in SKIP_NAMES or any(rel.endswith(e) for e in SKIP_EXT) or any(fnmatch.fnmatch(rel, g) for g in globs):
            continue
        if is_git and re.fullmatch(r"\.env(\.(?!example$|sample$|template$|schema$)[\w.-]+)?", name):
            findings.append({"rule": "env-file-committed", "severity": "high", "file": rel, "line": 0,
                             "match": name, "fix": f"git rm --cached {rel} && echo '{name}' >> .gitignore"})
        text = read_content(d, rel, source)
        if text is None:
            continue
        for n, line in enumerate(text.splitlines(), 1):
            if "envguard:allow" in line or len(line) > 2000:
                continue
            hit = False
            for rule, sev, rx in RULES:
                m = rx.search(line)
                if m:
                    secret = m.group(1) if rule == "url-credentials" else m.group(0)
                    if rule == "url-credentials" and PLACEHOLDER.search(secret):
                        continue
                    findings.append({"rule": rule, "severity": sev, "file": rel, "line": n, "match": mask(secret)})
                    hit = True
                    break
            if hit:
                continue
            m = ASSIGN.search(line)
            if m:
                val = m.group(2)
                if PLACEHOLDER.search(val) or val.isdigit() or entropy(val) < 3.0:
                    continue
                if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.]*(\(\))?", val) and not re.search(r"\d", val):
                    continue  # looks like a variable / attribute reference, not a literal
                findings.append({"rule": "generic-secret-assignment", "severity": "medium", "file": rel, "line": n,
                                 "match": f"{m.group(1)}={mask(val)}"})
    return {"files_scanned": len(files), "staged": staged, "findings": findings}


def parse_env(path: Path):
    out = {}
    if not path.is_file():
        return out
    for line in path.read_text(errors="replace").splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        out[k.replace("export ", "").strip()] = v.strip().strip('"').strip("'")
    return out


TYPES = {
    "str": lambda v, o: True,
    "int": lambda v, o: re.fullmatch(r"-?\d+", v) is not None,
    "float": lambda v, o: re.fullmatch(r"-?\d+(\.\d+)?", v) is not None,
    "bool": lambda v, o: v.lower() in {"true", "false", "1", "0", "yes", "no", "on", "off"},
    "url": lambda v, o: re.fullmatch(r"[a-z][a-z0-9+.-]*://\S+", v, re.I) is not None,
    "email": lambda v, o: re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", v) is not None,
    "port": lambda v, o: v.isdigit() and 0 < int(v) < 65536,
}


def parse_schema(path: Path):
    rules = []
    for n, line in enumerate(path.read_text().splitlines(), 1):
        s = line.split("#", 1)[0].strip()
        if not s:
            continue
        parts = s.split()
        key, typ = parts[0], (parts[1] if len(parts) > 1 else "str")
        opts = {"required": "optional" not in parts[2:], "min": None, "default": None}
        for p in parts[2:]:
            if p.startswith("min="):
                opts["min"] = int(p[4:])
            elif p.startswith("default="):
                opts["default"] = p[8:]
        rules.append((key, typ, opts, n))
    return rules


def validate(d: Path, env_file: str, schema_file: str):
    schema = d / schema_file
    env_path = d / env_file
    if not schema.is_file():
        return {"skipped": f"no {schema_file} (create one with: envguard init-schema)", "findings": []}
    env = parse_env(env_path)
    findings = []
    known = set()
    for key, typ, opts, line in parse_schema(schema):
        known.add(key)
        val = env.get(key, "")
        if not val:
            if opts["required"]:
                findings.append({"rule": "missing-required", "severity": "high", "key": key,
                                 "detail": f"{key} is required ({typ}) but not set in {env_file}"})
            continue
        if typ.startswith("enum:"):
            allowed = typ[5:].split("|")
            if val not in allowed:
                findings.append({"rule": "bad-value", "severity": "high", "key": key, "detail": f"must be one of {', '.join(allowed)}"})
        elif typ in TYPES and not TYPES[typ](val, opts):
            findings.append({"rule": "bad-type", "severity": "high", "key": key, "detail": f"expected {typ}"})
        elif typ not in TYPES and not typ.startswith("enum:"):
            findings.append({"rule": "unknown-type", "severity": "low", "key": key, "detail": f"schema line {line}: unknown type '{typ}'"})
        if opts["min"] and len(val) < opts["min"]:
            findings.append({"rule": "too-short", "severity": "medium", "key": key, "detail": f"shorter than {opts['min']} characters"})
    for key in env:
        if key not in known:
            findings.append({"rule": "undeclared", "severity": "low", "key": key, "detail": f"in {env_file} but not in {schema_file}"})
    return {"env": str(env_path), "schema": str(schema), "keys_checked": len(known), "findings": findings}


def init_schema(d: Path):
    src = d / ".env" if (d / ".env").is_file() else d / ".env.example"
    env = parse_env(src)
    if not env:
        raise SystemExit("envguard: no .env or .env.example to draft from")
    lines = ["# KEY  TYPE  required|optional  [min=N] [default=V]", "# types: str int float bool url email port enum:a|b|c"]
    for k, v in env.items():
        if TYPES["port"](v, {}) and "PORT" in k.upper():
            t = "port"
        elif TYPES["bool"](v, {}) and not v.isdigit():
            t = "bool"
        elif TYPES["int"](v, {}):
            t = "int"
        elif TYPES["url"](v, {}):
            t = "url"
        elif TYPES["email"](v, {}):
            t = "email"
        else:
            t = "str"
        extra = "  min=16" if re.search(r"KEY|SECRET|TOKEN|PASS", k, re.I) else ""
        lines.append(f"{k:<28} {t:<6} required{extra}")
    out = d / ".env.schema"
    if out.exists():
        raise SystemExit(f"envguard: {out} already exists")
    out.write_text("\n".join(lines) + "\n")
    return {"file": str(out), "keys": list(env)}


def deps(d: Path):
    results = []
    if (d / "requirements.txt").is_file() or (d / "pyproject.toml").is_file():
        if shutil.which("pip-audit"):
            args = ["pip-audit", "-f", "json", "--progress-spinner", "off"]
            if (d / "requirements.txt").is_file():
                args += ["-r", "requirements.txt"]
            p = subprocess.run(args, cwd=d, capture_output=True, text=True, timeout=600)
            try:
                data = json.loads(p.stdout or "{}")
                vulns = [{"package": dep["name"], "version": dep["version"], "id": v["id"], "fix": ",".join(v.get("fix_versions", []))}
                         for dep in data.get("dependencies", []) for v in dep.get("vulns", [])]
                results.append({"ecosystem": "python", "tool": "pip-audit", "vulnerabilities": vulns})
            except ValueError:
                results.append({"ecosystem": "python", "tool": "pip-audit", "error": (p.stderr or "")[-400:]})
        else:
            results.append({"ecosystem": "python", "skipped": "install pip-audit: pipx install pip-audit"})
    if (d / "package-lock.json").is_file():
        if shutil.which("npm"):
            p = subprocess.run(["npm", "audit", "--json"], cwd=d, capture_output=True, text=True, timeout=600)
            try:
                data = json.loads(p.stdout or "{}")
                vulns = [{"package": k, "severity": v.get("severity"), "fix": bool(v.get("fixAvailable"))}
                         for k, v in data.get("vulnerabilities", {}).items()]
                results.append({"ecosystem": "node", "tool": "npm audit", "vulnerabilities": vulns})
            except ValueError:
                results.append({"ecosystem": "node", "tool": "npm audit", "error": (p.stderr or "")[-400:]})
        else:
            results.append({"ecosystem": "node", "skipped": "npm not installed"})
    elif (d / "package.json").is_file():
        results.append({"ecosystem": "node", "skipped": "no package-lock.json (run npm install first)"})
    findings = []
    for r in results:
        for v in r.get("vulnerabilities", []):
            sev = "high" if v.get("severity") in ("high", "critical") or r["ecosystem"] == "python" else "medium"
            findings.append({"rule": "vulnerable-dependency", "severity": sev, **v})
    return {"audits": results, "findings": findings}


def install_hook(d: Path):
    top = git(d, "rev-parse", "--show-toplevel")
    if not top:
        raise SystemExit("envguard: not a git repository")
    hooks = Path((git(d, "rev-parse", "--git-path", "hooks") or ".git/hooks").strip())
    if not hooks.is_absolute():
        hooks = Path(top.strip()) / hooks
    hooks.mkdir(parents=True, exist_ok=True)
    hook = hooks / "pre-commit"
    me = Path(__file__).resolve()
    block = f'\n# envguard\n"{sys.executable}" "{me}" scan --staged --text || {{ echo "envguard: commit blocked (bypass once with git commit --no-verify)"; exit 1; }}\n'
    if hook.exists():
        content = hook.read_text()
        if "# envguard" in content:
            return {"hook": str(hook), "status": "already installed"}
        hook.write_text(content.rstrip("\n") + "\n" + block)
    else:
        hook.write_text("#!/bin/sh" + block)
    hook.chmod(hook.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return {"hook": str(hook), "status": "installed"}


def print_findings(title, res):
    print(f"== {title}")
    if res.get("skipped"):
        print(f"   skipped: {res['skipped']}")
    if "audits" in res and not res["audits"]:
        print("   nothing to audit (no requirements.txt, pyproject.toml or package-lock.json)")
        return
    for a in res.get("audits", []):
        if a.get("skipped"):
            print(f"   {a['ecosystem']}: skipped ({a['skipped']})")
        elif a.get("error"):
            print(f"   {a['ecosystem']}: error running {a['tool']}")
        else:
            print(f"   {a['ecosystem']}: {len(a['vulnerabilities'])} vulnerable package(s) via {a['tool']}")
    for f in res.get("findings", []):
        where = f"{f['file']}:{f['line']}" if "file" in f else f.get("key") or f.get("package", "")
        detail = f.get("match") or f.get("detail") or f.get("id", "")
        print(f"   [{f['severity'].upper():<6}] {f['rule']:<26} {where}  {detail}")
        if f.get("fix") and isinstance(f["fix"], str):
            print(f"            fix: {f['fix']}")
    if not res.get("findings") and not res.get("skipped"):
        print("   clean")


def main(argv):
    cap_mode = bool(argv) and argv[0] in CAPABILITIES
    if cap_mode:
        argv = CAPABILITIES[argv[0]] + argv[1:]
    cmds = {"all", "scan", "schema", "init-schema", "deps", "install-hook"}
    if not argv or argv[0] not in cmds and argv[0] not in ("-h", "--help", "--version"):
        argv = ["all"] + argv
    ap = argparse.ArgumentParser(prog="envguard", description=__doc__.split("\n")[0])
    ap.add_argument("--version", action="version", version=VERSION)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in cmds:
        sp = sub.add_parser(name)
        sp.add_argument("dir", nargs="?", default=".")
        sp.add_argument("--json", action="store_true")
        sp.add_argument("--text", action="store_true", help="human-readable output even when piped")
        if name in ("scan", "all"):
            sp.add_argument("--staged", action="store_true")
            sp.add_argument("--untracked", action="store_true", help="also scan untracked, non-ignored files")
        if name in ("schema", "all"):
            sp.add_argument("--env", default=".env")
            sp.add_argument("--schema", default=".env.schema")
    a = ap.parse_args(argv)
    d = Path(a.dir).expanduser().resolve()
    as_json = a.json or (not sys.stdout.isatty() and not a.text)

    if a.cmd in ("init-schema", "install-hook"):
        res = init_schema(d) if a.cmd == "init-schema" else install_hook(d)
        print(json.dumps(res, indent=2) if as_json else f"{a.cmd}: {res.get('status', 'wrote')} {res.get('file') or res.get('hook')}")
        return 0

    report = {"tool": "envguard", "version": VERSION, "dir": str(d)}
    if a.cmd in ("scan", "all"):
        report["scan"] = scan(d, a.staged, a.untracked)
    if a.cmd in ("schema", "all"):
        report["schema"] = validate(d, a.env, a.schema)
    if a.cmd in ("deps", "all"):
        report["deps"] = deps(d)
    allf = [f for k in ("scan", "schema", "deps") for f in report.get(k, {}).get("findings", [])]
    report["summary"] = dict(Counter(f["severity"] for f in allf))
    report["passed"] = not any(f["severity"] == "high" for f in allf)

    if as_json:
        print(json.dumps(report, indent=2))
    else:
        if "scan" in report:
            print_findings(f"Secrets ({report['scan']['files_scanned']} files)", report["scan"])
        if "schema" in report:
            print_findings("Environment schema", report["schema"])
        if "deps" in report:
            print_findings("Dependencies", report["deps"])
        s = report["summary"]
        print(("PASS" if report["passed"] else "FAIL") + f"  high={s.get('high', 0)} medium={s.get('medium', 0)} low={s.get('low', 0)}")
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
